# MIMIC-IV data (cannot be shared per PhysioNet agreement)
data/raw/mimic-iv/
data/processed/*
!data/processed/mimic_training/
!data/processed/mimic_training/*.csv
!data/processed/mimic_training/*.json

#Attention analysis
Attention_BERT/
Attention_Llama/

# Data files
*.csv
*.gz
*.json
*.pt
*.joblib
*.csv.gz

# Allow specific data directories
!data/simulation/tested/
!data/simulation/tested/*.csv
# KIP stores its sampled hidden rule (S, kappa) beside the CSVs. Without this the
# global *.json rule above would drop the sidecar and the data would ship with no
# way to decode its labels.
!data/simulation/tested/*_rule.json

# KIP GPU-training artifacts: checkpoints and per-run logs are large and
# machine-local; the shuffled control data is deterministically regenerable via
# `python -m src.data.kip_shuffles` (seed recorded in its shuffle_manifest.json).
# The aggregated results/kip_training.csv IS tracked (negations below).
checkpoints/
logs/kip/
data/simulation/kip_shuffled/
!results/kip_training.csv
!results/kip_training_p5.csv
!results/kip_training_fullft.csv
!data/processed/mimic_training/*.csv
!data/processed/mimic_training/*.json
!results/sensitivity/*.csv

# Large files
data/simulation/holes/sequences_with_holes.jsonl
Miniforge3-*.sh

# Logs and outputs
*.out
*.err
*.log
src/logs/
src/slurm_logs/
src/slurm-*.out
src/output_slurms_fox/
src/results/
src/results_rnn_baseline/

#Let's include mimic logs and sensitivity logs
!logs/mimic_*.out
!scripts/slurm/logs/sensitivity_*.out
!scripts/slurm/logs/sensitivity_*.err

# Per-epoch KIP curves + training logs shipped back from cluster runs (small
# text files; see scripts/slurm/FOX/kip/RUNBOOK.md — Olivia variant retained).
# Must stay BELOW the global *.out/*.err/*.log ignores so these negations win.
!results/kip_curves/
!results/kip_curves/*
# OC full-FT rebuttal arm (scripts/slurm/FOX/oc_fullft/README.md): fraction
# CSVs + trainlogs.
!results/oc_fullft/
!results/oc_fullft/*

# Include paper tables
!paper_tables/*.csv

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# IDE and environment
.venv/
.vscode/
*.egg-info/
.eggs/

# Secrets / credentials
.env
.env.*
!.env.example

# Notebooks (specific)
src/preprocessing_no_pyhealth.ipynb
src/mimiciv_clinical_dataset.csv
src/landmark_df.csv

# Cache
cache/
.cache/

# MIMIC cancer pipeline
mimic_analysis/data/intermediate/
mimic_analysis/data/processed/
mimic_analysis/data/hosp/
mimic_analysis/data/mimiciv_note/
mimic_analysis/data/dfci_models/
*.parquet

# RecSys audit raw/derived data (rebuilt deterministically; only code + manifest are tracked)
data/recsys/

# RecSys audit: tracked manifests + compact anchor artifacts (global *.json/*.log/*.gz rules above would drop them)
!scripts/recsys/*.json
!results/recsys_audit/
!results/recsys_audit/**
