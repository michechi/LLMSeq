    "def safe_join(x):\n",
    "    if pd.isna(x) or x in ['[]', '', 'None', 'NaN', 'na', 'nan']:\n",
    "        return ''\n",
    "    try:\n",
    "        x_eval = ast.literal_eval(x)\n",
    "        if isinstance(x_eval, list):\n",
    "            return '\\n'.join(x_eval)\n",
    "        else:\n",
    "            return ''\n",
    "    except:\n",
    "        return ''\n",
    "\n",
